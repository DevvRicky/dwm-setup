* {
    /*Colors*/
    bg0:       #00000090;
    colGry:    #7E7E7E80;
    colBlu:    #444444;
    colBlu1:   #444444;
    colWhi1:   #DEDEDE;
    colWhi2:   #FFFFFF;
    colWhi3:   #DEDEDE80;

    background-color:   transparent;
    text-color:         @colWhi1;
    
    margin:     0;
    padding:    0;
    spacing:    0;
}

window {
    background-color:   @bg0;
    width:          500;
    border:		1px;
    border-color:	@colWhi3;
}

inputbar {
    padding:    10px;
    spacing:    4px;
}

icon-search {
    expand:     false;
    filename:   "search";
    size: 10px;
}

icon-search, entry, element-icon, element-text {
    vertical-align: 0.5;
}

entry {
    font:   inherit;

    placeholder         : "Search";
    placeholder-color   : @colWhi3;
}

message {
    border:             2px 0 0;
    border-color:       @colGry;
    background-color:   @colGry;
}

textbox {
    padding:    8px 24px;
}

listview {
    lines:      10;
    columns:    1;

    fixed-height:   false;
    border:         1px 0 0;
    border-color:   @colGry;
}

element {
    padding:            8px 8px;
    spacing:            8px;
    background-color:   transparent;
}

element normal active {
    text-color: @colBlu;
}

element alternate active {
    text-color: @colBlu;
}

element selected normal, element selected active {
    background-color:   @colBlu;
    text-color:         @colWhi2;
}

element-icon {
    size:   1em;
}

element-text {
    text-color: inherit;
}
