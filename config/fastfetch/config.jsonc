{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
	"type":"file",
        "source": "~/.config/fastfetch/Arts/voidsmall.txt",
	"color": {
	    "1": "green"
	},
        "padding": {
	    "left": 2,
	    "top":  1,
	    "right": 3
	}
    },
    "display": {
        "separator": " -> "
    },
    "modules": [
	{
	    "type": "title",
	    "key": "",
	    "color": {
		"user": "white",
		"at": "white",
		"host": "white",
		"keyColor": "white"
	    }
	},
	 {
	    "type": "custom",
	    "format": "─────────────────"
	},
        {
            "type": "os",
            "key": " OS",
            "keyColor": "green",
            "format": "{3}"
        },
        {
            "type": "kernel",
            "key": "├",
            "keyColor": "green"
        },
        {
            "type": "packages",
            "key": "├󰏖",
            "keyColor": "green"
        },
        {
            "type": "shell",
            "key": "├",
            "keyColor": "green"
        },
        {
            "type": "wm",
            "key": "├",
            "keyColor": "green"
        },
	{
	    "type": "disk",
	    "key": "├󱦟",
	    "folders": "/",
            "keyColor": "green",
	    "format": "{days} days"
	},
        {
            "type": "uptime",
            "key": "└󰅐",
            "keyColor": "green"
        },

	"break",
        
	{
	    "type": "colors",
	    "paddingLeft": 0,
	    "symbol": "square"
	}

    ]
}
